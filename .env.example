# Copy to .env for local development. Never commit .env.
COMPOSE_PROJECT_NAME=knowledge-workspace

# PostgreSQL (local Docker Compose)
POSTGRES_DB=knowledge_workspace
POSTGRES_USER=knowledge_app
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_PORT=5432

# Backend
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://knowledge_app:replace-with-a-local-secret@db:5432/knowledge_workspace

# Set to the absolute path of your local Obsidian vault on the host.
# The Compose mount must be adjusted for your OS/path; do not expose the entire home directory.
OBSIDIAN_VAULT_PATH=./sample-vault

# AI is disabled unless explicitly configured and invoked by a user action.
AI_ENABLED=false
GOOGLE_API_KEY=
GOOGLE_MODEL=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=personal-knowledge-workspace
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Optional NLP
SPACY_MODEL=en_core_web_sm
